{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "ClickHouse Observe",
  "id": "poortuna-clickhouse-observe-app",
  "backend": false,
  "info": {
    "keywords": [
      "clickhouse",
      "logs",
      "observability",
      "otel"
    ],
    "description": "HyperDX-style log explorer for ClickHouse. Companion app — requires the ClickHouse datasource plugin.",
    "author": {
      "name": "PoorTuna"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "0.4.1",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Logs",
      "path": "/a/poortuna-clickhouse-observe-app/logs",
      "addToNav": true,
      "defaultNav": false,
      "icon": "document-info"
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/poortuna-clickhouse-observe-app",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.0.0",
    "plugins": [
      {
        "type": "datasource",
        "id": "grafana-clickhouse-datasource",
        "name": "ClickHouse"
      }
    ]
  }
}
