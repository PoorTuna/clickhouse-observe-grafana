{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "ClickHouse Observe",
  "id": "poortuna-clickhouse-observe-app",
  "backend": false,
  "info": {
    "keywords": [
      "clickhouse",
      "logs",
      "traces",
      "observability",
      "otel"
    ],
    "description": "HyperDX-style log and trace explorer for ClickHouse. Companion app — requires the ClickHouse datasource plugin.",
    "author": {
      "name": "PoorTuna"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "0.2.4",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Logs",
      "path": "/a/%PLUGIN_ID%/logs",
      "addToNav": true,
      "defaultNav": false,
      "icon": "document-info"
    },
    {
      "type": "page",
      "name": "Traces",
      "path": "/a/%PLUGIN_ID%/traces",
      "addToNav": true,
      "defaultNav": false,
      "icon": "distributed-tracing"
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.0.0"
  }
}
